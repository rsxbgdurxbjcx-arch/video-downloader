# ===== 运行环境 =====
APP_ENV=development
# 默认监听 80（HTTP 默认端口）：Cloudflare 代理回源 / 服务器 IP 直连均无需填写端口
# 如本机 80 被占用或需换端口：APP_ADDR=:8080（并同步 docker-compose.yml ports 映射）
APP_ADDR=:80
# 域名场景：APP_BASE_URL=https://video.example.com（通过 Cloudflare 或反代访问）
# IP 直连场景：APP_BASE_URL=http://服务器IP
APP_BASE_URL=http://localhost

# ===== 数据库（SQLite 文件路径；使用 file: 前缀可传 PRAGMA 参数）=====
DATABASE_URL=./data/app.db

# ===== 安全密钥（务必替换！生成方式见 README）=====
# SESSION_SECRET：openssl rand -hex 32
SESSION_SECRET=replace-with-random-secret
# COOKIE_ENCRYPTION_KEY：openssl rand -hex 32（32 字节，加密平台 Cookie 用）
COOKIE_ENCRYPTION_KEY=replace-with-32-byte-key

# ===== 初始管理员（生产环境必须修改默认密码，否则拒绝启动）=====
ADMIN_INITIAL_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=change-me

# ===== Spug 推送助手 - 邮件验证码（替代原 QQ 邮箱邮件推送）=====
# ⭐ 一键部署后 .env 将预填本示例；请登录服务器按 README「接入 Spug 推送助手邮件验证码」修改：
#    1. push.spug.cc → 控制台 → 验证码 → 邮件：选中官方模板（中文/英文）后复制「模板编码」；
#    2. 开发者设置 → 安全设置：把服务器出网 IP 加入 IP 白名单（否则接口返回 403 IP安全策略拒绝）；
#    3. 把占位符 your-spug-template-code 换成真实模板编码。
# 注意：模板编码是调用凭证，只保存在服务器本地 .env（.gitignore 已忽略），切勿提交 Git/日志。
SPUG_MAIL_ENABLED=true
SPUG_MAIL_BASE_URL=https://push.spug.cc
SPUG_MAIL_TEMPLATE_CODE=your-spug-template-code
# ===== 邮箱验证码（6 位数字）规则 =====
EMAIL_VERIFICATION_EXPIRE_MINUTES=5    # 验证码有效期（默认 5 分钟）
EMAIL_SEND_COOLDOWN_SECONDS=60         # 同一邮箱冷却期（默认 60 秒）
EMAIL_HOURLY_LIMIT=6                   # 同一邮箱每小时最多发送次数（默认 6）
EMAIL_IP_HOURLY_LIMIT=30               # 同一 IP 每小时最多发送次数（默认 30，防换邮箱刷邮件）
VERIFY_CODE_MAX_ATTEMPTS=5             # 验证码错误最大尝试次数（默认 5，超限作废）

# ===== Redis（可选；配置后邮件限流使用 Redis 计数，未配置/不可用时自动降级数据库）=====
# docker compose 部署：无需配置（自动连 compose 内 redis 服务）
# 本机 go run 部署：redis://[user:pass@]host:port[/db]，如 redis://127.0.0.1:6379
REDIS_URL=

# ===== 支付（本阶段仅 Mock；生产环境禁止 PAYMENT_ENABLED=true + mock）=====
PAYMENT_ENABLED=false
PAYMENT_PROVIDER=mock           # mock（仅开发） | manual（管理员手动确认）

# ===== 下载 =====
DOWNLOAD_DIR=./downloads
COOKIE_DIR=./cookies_store
MAX_DOWNLOAD_SIZE=0             # 0 不限；单位字节
TASK_EXPIRE_HOURS=6

# ===== 安全开关 =====
RATE_LIMIT_ENABLED=true
CSRF_ENABLED=true
# CORS_ALLOWED_ORIGINS=https://a.com,https://b.com  # 需要跨域时配置白名单

# ===== 外部工具（可选，默认搜索 PATH）=====
# YTDLP_PATH=yt-dlp
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
